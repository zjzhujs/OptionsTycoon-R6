  },
  {
    "id": "echo_daniel_supported_loss_1",
    "character_id": "daniel_ross",
    "situation": "SUPPORTED_LOSS",
    "line": "很遗憾看到今早的净值波动。为了保护双方的信用底线，系统已将您的质押率下调 15%。希望这不会影响我们愉快的合作关系。",
