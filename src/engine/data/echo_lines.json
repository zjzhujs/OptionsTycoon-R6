  },
  {
    "id": "echo_marcus_opposed_loss_3",
    "character_id": "marcus_reed",
    "situation": "OPPOSED_LOSS",
    "line": "当风控被当成摆设时，法律就成了唯一的约束。今天这场灾难性的违规爆仓，会在你们的金融从业执照上留下永久污点。",
    "tone": "FORMAL_DEVASTATION"
  },
  {
    "id": "echo_daniel_supported_win_1",
    "character_id": "daniel_ross",
    "situation": "SUPPORTED_WIN",
